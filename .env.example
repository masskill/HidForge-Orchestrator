# Non-secret settings only. Copy to .env to override defaults.
# Where the SQLite database and task worktrees live (default: %LOCALAPPDATA%\HidForge)
HIDFORGE_DATA_DIR=.hidforge-data
# Local UI/API port (always bound to 127.0.0.1)
HIDFORGE_PORT=4317
# Default parallel workers (can be changed in the UI)
HIDFORGE_MAX_CONCURRENT=2
# Kill a worker that prints nothing for this many seconds
HIDFORGE_STALL_TIMEOUT_SEC=600

# Non-secret settings only. Copy to .env to override defaults.
# Where the SQLite database and task worktrees live (default: %LOCALAPPDATA%\HidForge)
HIDFORGE_DATA_DIR=.hidforge-data
# Local UI/API port (always bound to 127.0.0.1)
HIDFORGE_PORT=4317
# Default parallel workers (can be changed in the UI)
HIDFORGE_MAX_CONCURRENT=2
# Kill a worker that prints nothing for this many seconds
HIDFORGE_STALL_TIMEOUT_SEC=600

# --- Paid API fallback (optional, SECRET: put real values only in .env, never in .env.example) ---
# Used only when the agent's CLI is missing or not logged in AND "Резервний API (платно)" is enabled in Settings.
# HidForge never stores these keys; it only passes them to the API agent process.
# ANTHROPIC_API_KEY=      # Claude Code -> Anthropic API
# OPENAI_API_KEY=         # Codex -> OpenAI API
# GEMINI_API_KEY=         # Antigravity -> Gemini API (OpenAI-compatible endpoint)
# API-only providers (no CLI needed), same rules:
# DEEPSEEK_API_KEY=       # DeepSeek
# MOONSHOT_API_KEY=       # Kimi (Moonshot AI)
# MINIMAX_API_KEY=        # MiniMax
# DASHSCOPE_API_KEY=      # Qwen (Alibaba Model Studio, international)
# ZAI_API_KEY=            # GLM (Z.ai)
# XAI_API_KEY=            # Grok (xAI)
# MISTRAL_API_KEY=        # Mistral
# OPENROUTER_API_KEY=     # OpenRouter
